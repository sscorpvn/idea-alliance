---
<Base title="Đội ngũ — IDEA" active="covan">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Đội ngũ liên minh</span>
      <h1 class="display">Ban lãnh đạo &amp; chuyên gia IDEA</h1>
      <p class="lede measure">Nòng cốt là các chuyên gia hàng đầu về công nghệ, an ninh mạng, pháp chế, tài chính và truyền thông — đồng hành cùng thành viên qua từng ban chuyên môn.</p>
    </div>
  </section>

  <section class="band white">
    <div class="wrap">
      <div class="band-head">
        <span class="eyebrow">Hội đồng liên minh</span>
        <h2 class="display-sm">Ban lãnh đạo</h2>
      </div>
      <div class="grid-4">
        {board.map(([n, r, d, img]) => (
          <div class="person">
            <img class="photo" src={img} alt={n} loading="lazy" style="aspect-ratio:1;border-radius:50%" />
            <h3 style="font-size:19px">{n}</h3>
            <div class="role" style="font-size:11.5px">{r}</div>
            <p style="font-size:13.5px">{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap cols split-39" style="align-items:start">
      <div>
        <span class="eyebrow">Mạng lưới chuyên môn</span>
        <h2 class="display-sm" style="font-size:clamp(26px,2.6vw,34px)">Chuyên gia &amp; cố vấn thành viên</h2>
        <p class="lede" style="margin-top:16px">Cùng đội ngũ kỹ sư, chuyên viên phát triển sản phẩm của các đơn vị thành viên trong liên minh.</p>
      </div>
      <div class="rows">
        {experts.map(([n, r]) => (
          <div class="row-item"><div class="meta">Chuyên gia</div><div><h3 style="font-size:18px">{n}</h3><p>{r}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand h="Kết nối với các ban chuyên môn" p="Để lại thông tin để IDEA sắp xếp buổi trao đổi với đúng chuyên gia bạn cần." />
</Base>
