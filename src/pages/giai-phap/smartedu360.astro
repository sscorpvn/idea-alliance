---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
const tiers = [
  ['1', 'Phòng học thông minh', 'Dạy nhiều lớp cùng lúc, ghi hình tự động, phát trực tiếp, quản lý tập trung.'],
  ['2', 'Bảng thông minh + Kết nối LMS', 'Bảng giảng chung cho mọi phòng; tài liệu, video gắn với LMS của trường.'],
  ['3', 'AI lớp học (Enterprise)', 'Tự phân tích tiết học, ghi biên bản, báo cáo chất lượng cho ban giám hiệu.'],
];
const problems = [
  ['Chất lượng không đều', 'Giáo viên giỏi chỉ dạy được một lớp tại một thời điểm; điểm trường lẻ thiếu giáo viên bộ môn.'],
  ['Gián đoạn học tập', 'Nghỉ ốm, thời tiết, khoảng cách khiến học sinh lỡ bài — không có bản xem lại.'],
  ['Quản lý thiếu dữ liệu', 'Ban giám hiệu không thấy lớp nào đang dạy; không có dữ liệu thực tế về tiết học, thiết bị, chuyên cần.'],
];
const ai = [
  ['Nhật ký tiết học', 'Diễn biến tiết học gắn với đoạn video tương ứng.'],
  ['Nhận diện giáo viên', 'Ghi nhận giáo viên có mặt, đúng giờ, đúng phòng.'],
  ['Mức độ tập trung', 'Mức độ chú ý của lớp theo từng thời điểm.'],
  ['Âm thanh lớp học', 'Phát hiện tiếng ồn, gián đoạn trong giờ.'],
  ['Biên bản bài giảng', 'Chuyển giọng nói thành văn bản, tóm tắt nội dung.'],
  ['Báo cáo tiết học', 'Đánh giá chất lượng tiết học, hỗ trợ ra quyết định.'],
];
const scenarios = [
  ['Trường phổ thông nhiều điểm trường', 'Giáo viên dạy tại điểm chính — 3 điểm lẻ học cùng lúc; học sinh điểm lẻ giơ tay được duyệt phát biểu; trắc nghiệm cuối giờ có kết quả theo từng phòng.'],
  ['Đại học · Cao đẳng', 'Bắt đầu buổi học từ LMS đúng lớp đúng phòng; mở slide lên bảng giảng và ghi chú trực tiếp; sinh viên ở xa xem qua link; kết thúc buổi học bản ghi về LMS.'],
  ['Trung tâm ngoại ngữ · Đào tạo', 'Học viên online quét QR vào lớp trên điện thoại; luyện nói duyệt phát biểu từng người; biên bản bài giảng để học viên ôn lại.'],
  ['Sở · Phòng Giáo dục và Đào tạo', 'Màn hình quản lý thấy lớp nào đang dạy; thiết bị mất kết nối cảnh báo ngay; dự giờ không cần đến trường; quyết định dựa trên dữ liệu.'],
];
---
<Base title="SmartEdu360 — IDEA" active="solutions">
  <section class="page-head">
    <div class="wrap cols split-57">
      <div>
        <span class="eyebrow">Bitcare · Kiến tạo giáo dục thông minh</span>
        <h1 class="display">SmartEdu360 — Nền tảng phòng học thông minh</h1>
        <p class="lede">Dạy một nơi, học mọi nơi, xem lại mọi lúc. Dạy nhiều lớp cùng lúc · bảng giảng điện tử · kết nối LMS · trợ lý AI.</p>
        <div class="actions" style="margin-top:28px;display:flex;gap:24px;flex-wrap:wrap">
          <a class="btn btn-lg" href="/lien-he">Nhận demo miễn phí</a>
          <a class="arrow" href="https://www.bitcare.com.vn" target="_blank" rel="noopener">bitcare.com.vn</a>
        </div>
      </div>
      <div class="card" style="display:flex;align-items:center;justify-content:center;padding:40px">
        <img src="/assets/se-logo.webp" alt="SmartEdu360 — Kiến tạo giáo dục thông minh" style="max-width:360px;width:100%" />
      </div>
    </div>
  </section>

  <section class="band white">
    <div class="wrap">
      <div class="band-head">
        <span class="eyebrow">Thực trạng</span>
        <h2 class="display-sm">Bài giảng tốt chưa đến được với mọi lớp học</h2>
      </div>
      <div class="grid-3">
        {problems.map(([t, d], i) => (
          <div class="card"><div class="num">{String(i + 1).padStart(2, '0')}</div><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
      <div class="card" style="margin-top:24px"><p style="color:var(--ink)"><b style="font-weight:600">Điểm khác biệt:</b> phần mềm họp trực tuyến được thiết kế cho cuộc họp — SmartEdu360 được thiết kế cho lớp học và thiết bị trong phòng: mỗi phòng không phải một "cuộc họp riêng" mà liên kết nhiều phòng, điều phối tập trung; học sinh quét QR vào lớp không cần cài app; bài giảng ghi tự động và trả về đúng LMS của trường.</p></div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head center">
        <span class="eyebrow">3 cấp sản phẩm — mỗi cấp bao gồm toàn bộ tính năng của cấp trước</span>
        <h2 class="display-sm">Bắt đầu từ phòng học, nâng dần đến AI</h2>
      </div>
      <div class="grid-3">
        {tiers.map(([n, t, d]) => (
          <div class="card"><div class="num">{n}</div><h3>{t}</h3><p>{d}</p></div>
        ))}
      </div>
      <div class="grid-4" style="margin-top:24px">
        <div class="card center" style="padding:22px"><h3 style="margin-top:0">Đa điểm</h3><p>Một giáo viên, nhiều phòng học</p></div>
        <div class="card center" style="padding:22px"><h3 style="margin-top:0">QR</h3><p>Học sinh vào lớp, không cần cài app</p></div>
        <div class="card center" style="padding:22px"><h3 style="margin-top:0">LMS</h3><p>Lớp học và bài học ở cùng một nơi</p></div>
        <div class="card center" style="padding:22px"><h3 style="margin-top:0">24/7</h3><p>Hỗ trợ kỹ sư Việt Nam</p></div>
      </div>
    </div>
  </section>

  <section class="band white">
    <div class="wrap cols split-57" style="align-items:start">
      <div>
        <span class="eyebrow">Cấp 1 · Phòng học thông minh</span>
        <h2 class="display-sm" style="font-size:clamp(26px,3vw,38px)">Lớp học liên kết: dạy một nơi, học nhiều nơi</h2>
        <div class="rows" style="margin-top:22px">
          <div class="row-item"><div class="meta">01</div><div><h3 style="font-size:17px">Dạy nhiều phòng</h3><p>Các phòng cùng nghe, cùng nhìn, cùng trao đổi — học sinh điểm lẻ hiện ngay trên màn hình lớp chính.</p></div></div>
          <div class="row-item"><div class="meta">02</div><div><h3 style="font-size:17px">Tương tác &amp; kiểm tra</h3><p>Giơ tay phát biểu, nhắn tin, điểm danh, làm trắc nghiệm theo từng phòng.</p></div></div>
          <div class="row-item"><div class="meta">03</div><div><h3 style="font-size:17px">Ghi hình tự động &amp; phát trực tiếp</h3><p>Mỗi buổi học tự động được ghi lại; chia sẻ link có khoá, phát lên YouTube, Facebook.</p></div></div>
        </div>
      </div>
      <div>
        <img class="r16" src="/assets/se-class.webp" alt="Một tiết, nhiều lớp — học sinh các điểm trường trên màn hình lớp chính" loading="lazy" />
        <img class="r16" src="/assets/se-home.webp" alt="Nghỉ học không lỡ bài — học sinh xem lại tiết học tại nhà" loading="lazy" style="margin-top:16px" />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap cols split-57" style="align-items:start">
      <img class="r16" src="/assets/se-board.webp" alt="Bảng thông minh — học sinh lên bảng, giáo viên mời, cả lớp cùng theo dõi" loading="lazy" />
      <div>
        <span class="eyebrow">Cấp 2 · Bảng thông minh + LMS</span>
        <h2 class="display-sm" style="font-size:clamp(26px,3vw,38px)">Một bảng giảng cho mọi phòng</h2>
        <div class="rows" style="margin-top:22px">
          <div class="row-item"><div class="meta">01</div><div><h3 style="font-size:17px">Bảng giảng dùng chung</h3><p>Giáo viên viết, vẽ — mọi phòng thấy cùng lúc; mời học sinh phòng khác lên bảng làm bài tại chỗ.</p></div></div>
          <div class="row-item"><div class="meta">02</div><div><h3 style="font-size:17px">Mở tài liệu lên bảng</h3><p>Word, PowerPoint, PDF, ảnh — mở ra giảng và ghi chú trực tiếp.</p></div></div>
          <div class="row-item"><div class="meta">03</div><div><h3 style="font-size:17px">Kết nối LMS</h3><p>Bắt đầu buổi học từ LMS, dạy với tài liệu có sẵn, video tiết học gắn vào bài học để xem lại — nghỉ học vẫn có bài giảng đúng nơi các em vẫn học.</p></div></div>
        </div>
      </div>
    </div>
  </section>

  <section class="band white">
    <div class="wrap cols split-57" style="align-items:start">
      <div>
        <span class="eyebrow">Quản lý tập trung + Cấp 3 · AI lớp học (Enterprise)</span>
        <h2 class="display-sm" style="font-size:clamp(26px,3vw,38px)">Mọi phòng học trên một màn hình</h2>
        <p class="lede" style="margin-top:16px">Màn hình ban giám hiệu theo dõi lớp đang học, dự giờ từ xa; tài khoản phân quyền theo phần việc, quản lý nhiều trường; cảnh báo ngay khi camera, máy tính mất kết nối.</p>
        <div class="grid-2" style="margin-top:20px;gap:14px">
          {ai.map(([t, d]) => (<div class="card" style="padding:20px"><h3 style="margin-top:0;font-size:15.5px">{t}</h3><p style="font-size:13.5px">{d}</p></div>))}
        </div>
      </div>
      <img class="r16" src="/assets/se-manage.webp" alt="Dự giờ từ xa — không cần đến lớp vẫn nắm được tiết học" loading="lazy" />
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head">
        <span class="eyebrow">Kịch bản ứng dụng</span>
        <h2 class="display-sm">Mỗi đơn vị một bài toán, cùng một nền tảng</h2>
      </div>
      <div class="grid-2">
        {scenarios.map(([t, d]) => (<div class="card" style="padding:30px"><h3>{t}</h3><p>{d}</p></div>))}
      </div>
    </div>
  </section>

  <section class="band white">
    <div class="wrap cols split-39" style="align-items:start">
      <div>
        <span class="eyebrow">Triển khai</span>
        <h2 class="display-sm" style="font-size:clamp(26px,2.6vw,34px)">Theo từng phòng, tại trường hoặc trên đám mây</h2>
      </div>
      <div class="rows">
        <div class="row-item"><div class="meta">Thiết bị</div><div><h3 style="font-size:17px">Dùng được camera, đầu ghi hình phổ biến nhiều hãng</h3><p>Màn hình cảm ứng, micro, loa; mở rộng dần theo nhu cầu từng phòng.</p></div></div>
        <div class="row-item"><div class="meta">Người dùng</div><div><h3 style="font-size:17px">Trình duyệt trên máy tính và điện thoại — không cần cài app</h3><p>Chrome, Edge, Safari; học sinh vào lớp bằng QR hoặc link.</p></div></div>
        <div class="row-item"><div class="meta">Bảo mật</div><div><h3 style="font-size:17px">Kết nối mã hoá · đăng nhập 2 lớp · phân quyền</h3><p>Khoá link chia sẻ bất cứ lúc nào; dữ liệu có thể lưu hoàn toàn trên hạ tầng của đơn vị.</p></div></div>
        <div class="row-item"><div class="meta">Hạ tầng</div><div><h3 style="font-size:17px">Đặt tại trường hoặc trên đám mây</h3><p>Cấu hình máy chủ tư vấn riêng theo số phòng học, số camera và thời gian lưu video.</p></div></div>
      </div>
    </div>
  </section>

  <CtaBand h="Sẵn sàng nâng cấp phòng học?" p="Liên hệ để nhận khảo sát, tư vấn và bản demo miễn phí — hỗ trợ kỹ sư Việt Nam 24/7." img="/assets/se-class.webp" />
</Base>
