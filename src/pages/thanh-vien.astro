---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
const advantages: [string, string][] = [
  ['IETD & DVL Ventures', 'Đầu tư, gọi vốn, quản lý & phát triển tài sản'],
  ['Nhanlucdy.vn', 'Nền tảng chăm sóc con người, sức khoẻ'],
  ['SSCorp & ICTS', 'Giải pháp xã hội và Social Business'],
  ['CSTID & SSCorp', 'Công nghệ, chuyển đổi số và tái cấu trúc'],
  ['DVL Group', 'Luật, đấu thầu, đầu tư, quản lý dự án'],
  ['ATZ, TikTak & SliverSea Media', 'Design & Branding, Video Product & Media'],
  ['VIPDS & HYDROS', 'Môi trường và các giải pháp xanh: cấp & xử lý nước thải, năng lượng xanh'],
  ['… và các thành viên', 'Đa ngành nghề, đa lĩnh vực trong hệ sinh thái liên minh'],
];
---
<Base title="Thành viên — IDEA" active="member">
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">IDE Alliance Membership</span>
      <h1 class="display">Trở thành thành viên liên minh</h1>
      <p class="lede measure">Thành viên Liên minh IDE là các tổ chức, doanh nghiệp, startup, dự án kinh doanh, các lãnh đạo và cá nhân mong muốn tham gia, cam kết đồng hành cùng triết lý, hệ tư tưởng và văn hoá của liên minh.</p>
    </div>
  </section>

  <section class="band white">
    <div class="wrap grid-3">
      <article class="pillar"><img src="/assets/home3.webp" alt="" loading="lazy" />
        <div class="pad"><h3 class="title-sans">Tổ chức &amp; doanh nghiệp</h3><p>Cần nguồn lực vận hành, truyền thông, công nghệ và kết nối thị trường trong hệ sinh thái.</p><a class="arrow" href="/economy">Giải pháp cho doanh nghiệp</a></div></article>
      <article class="pillar"><img src="/assets/home2.webp" alt="" loading="lazy" />
        <div class="pad"><h3 class="title-sans">Startup &amp; dự án kinh doanh</h3><p>Khởi sự kinh doanh với sự đồng hành của chuyên gia, nhà đầu tư và cộng đồng liên minh.</p><a class="arrow" href="/co-van">Đội ngũ chuyên gia</a></div></article>
      <article class="pillar"><img src="/assets/home4.webp" alt="" loading="lazy" />
        <div class="pad"><h3 class="title-sans">Lãnh đạo &amp; cá nhân</h3><p>Leader và chuyên gia muốn phát triển trong cộng đồng kinh doanh tác động xã hội tử tế.</p><a class="arrow" href="/ve-chung-toi">Triết lý liên minh</a></div></article>
    </div>
  </section>

  <section class="band">
    <div class="wrap cols split-39" style="align-items:start">
      <div>
        <span class="eyebrow">IDEA Co-Growth Space</span>
        <h2 class="display-sm" style="font-size:clamp(26px,2.6vw,34px)">Lợi thế từ các thành viên đồng hành</h2>
      </div>
      <div class="rows">
        {advantages.map(([t, d]) => (
          <div class="row-item"><div class="meta">Thành viên</div><div><h3 style="font-size:18px">{t}</h3><p>{d}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="band white">
    <div class="wrap">
      <div class="band-head center">
        <span class="eyebrow">Quyền lợi &amp; thủ tục</span>
        <h2 class="display-sm">Gia nhập thế nào?</h2>
      </div>
      <div class="grid-3">
        <div class="card"><div class="num">01</div><h3>Trao đổi với Ban thư ký</h3><p>Để lại thông tin — Ban thư ký liên minh sẽ liên hệ giới thiệu mô hình, quyền lợi và mức phí thành viên phù hợp.</p></div>
        <div class="card"><div class="num">02</div><h3>Cam kết đồng hành</h3><p>Thống nhất triết lý, hệ tư tưởng và văn hoá của liên minh — hành động theo kim chỉ nam chung.</p></div>
        <div class="card"><div class="num">03</div><h3>Kết nối nguồn lực</h3><p>Tham gia các ban chuyên môn, không gian dịch vụ và cộng đồng IDEA Community.</p></div>
      </div>
    </div>
  </section>

  <CtaBand h="Gia nhập Liên minh IDEA" p="Để lại thông tin — Ban thư ký sẽ liên hệ hướng dẫn thủ tục thành viên." img="/assets/partner1.webp" />
</Base>
