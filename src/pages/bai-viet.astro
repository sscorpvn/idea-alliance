---
import Base from '../layouts/Base.astro';
import article from '../data/article.html?raw';
---
<Base title="Trồng cây xanh, chữa lành tâm hồn — IDEA" active="news">
  <section class="page-head" style="padding-bottom:30px">
    <div class="wrap article-head">
      <span class="eyebrow">Tin tức</span>
      <h1 class="display" style="font-size:clamp(30px,4vw,54px)">Trồng cây xanh, chữa lành tâm hồn</h1>
      <div class="article-meta">26 · 08 · 2023 — <b>IDEA</b></div>
    </div>
  </section>
  <section class="band white" style="padding-top:64px">
    <div class="wrap">
      <div class="article article-body" set:html={article} />
      <div class="article" style="margin-top:48px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:16px">
        <a class="arrow" href="/tin-tuc">Tất cả bài viết</a>
        <a class="link" href="https://spms2.com/trong-cay-xanh-chua-lanh-tam-hon/" target="_blank" rel="noopener">Bài gốc</a>
      </div>
    </div>
  </section>
</Base>
