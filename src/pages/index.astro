---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import PillarCards from '../components/PillarCards.astro';
import NewsRows from '../components/NewsRows.astro';
import quotes from '../data/testimonials.json';
const principles = [
  ['Gia tăng doanh thu', 'Hệ sinh thái truyền thông, bán hàng và kết nối khách hàng – đối tác cho thành viên liên minh.'],
  ['Tối ưu chi phí', 'Uỷ thác vận hành với các phòng chức năng thuê ngoài, tập trung nguồn lực cho cốt lõi.'],
  ['Phát triển nguồn lực bền vững', 'Tư vấn, đào tạo và kiến trúc doanh nghiệp theo hệ quản trị nguồn lực Trí – Nhân – Tài – Vật.'],
  ['Tận dụng nguồn lực xã hội', 'Sử dụng hiệu quả các nguồn lực xã hội — tư duy cộng sinh, đồng sở hữu, cùng tạo giá trị.'],
  ['Phục hồi văn hoá truyền thống', 'Góp phần phục hồi văn hoá truyền thống Việt Nam và thế giới trong đời sống kinh doanh.'],
];
---
<Base title="IDEA — Liên minh Kinh tế số & ĐMST" active="home">
  <section class="hero">
    <div class="wrap cols">
      <div>
        <span class="eyebrow">Innovation &amp; Digital Economy Alliance — Làm việc tốt mỗi ngày</span>
        <h1 class="display">Nơi kiến tạo không gian sống và làm việc</h1>
        <p class="lede">IDEA là nơi kiến tạo không gian sống và làm việc từ ươm tạo tới trưởng thành — phát triển cho cá nhân đến nhóm, tổ chức, doanh nghiệp và xa hơn nữa là quê hương, xã hội.</p>
        <div class="actions">
          <a class="btn btn-lg" href="/thanh-vien">Tham gia liên minh</a>
          <a class="arrow" href="/economy">Sản phẩm &amp; giải pháp</a>
        </div>
      </div>
      <div class="hero-img"><img src="/assets/hs-globe.webp" alt="Hệ thống liên minh IDEA" /></div>
    </div>
  </section>

  <section class="band white">
    <div class="wrap">
      <div class="band-head">
        <span class="eyebrow">Triết lý kinh doanh có trách nhiệm xã hội</span>
        <h2 class="display-sm">Năm tôn chỉ cốt lõi</h2>
      </div>
      <div class="grid-3">
        {principles.map(([t, d], i) => (
          <div class="card"><div class="num">{String(i + 1).padStart(2, '0')}</div><h3>{t}</h3><p>{d}</p></div>
        ))}
        <div class="card" style="display:flex;flex-direction:column;justify-content:center">
          <p style="color:var(--ink);font-family:var(--serif);font-size:19px;line-height:1.5">Hành động theo kim chỉ nam:<br /><b style="font-weight:500">Chắc chắn – Tin cậy – Hiệu quả – Giá thành phù hợp</b></p>
          <a class="arrow" href="/ve-chung-toi">Triết lý của liên minh</a>
        </div>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap cols split-75">
      <div>
        <span class="eyebrow">Từ 2017 đến nay</span>
        <h2 class="display-sm">Từ IETD đến Liên minh IDEA</h2>
        <p class="lede" style="margin-top:20px">Năm 2017, Viện Nghiên cứu Phát triển Kinh tế Thương mại (IETD), SSCorp, DVL Ventures cùng các doanh nghiệp trong hệ sinh thái thành lập liên minh với nòng cốt là đội ngũ chuyên gia công nghệ thông tin, đồng hành chuyển đổi số cho hàng trăm doanh nghiệp qua từng giai đoạn công nghệ 2.0 – 3.0 – 4.0.</p>
        <p style="margin-top:14px">Gần đây nhất, Trung tâm KHCN Đổi mới sáng tạo &amp; Chuyển đổi số (CSTID) – Viện IETD đã chủ trì thành lập <b style="color:var(--ink);font-weight:500">Liên minh Kinh tế số &amp; Đổi mới sáng tạo (IDEA)</b> — liên minh kết nối nguồn lực quốc gia và quốc tế về nghiên cứu, tư vấn chính sách, phát triển hệ sinh thái và triển khai các giải pháp chuyển đổi số – đổi mới sáng tạo.</p>
        <p style="margin-top:16px"><a class="arrow" href="/ve-chung-toi">Câu chuyện đầy đủ</a></p>
      </div>
      <div class="img-r16"><img src="/assets/house.webp" alt="Hệ quản trị nguồn lực liên minh" loading="lazy" style="background:#fff;padding:10px;border-radius:16px" /></div>
    </div>
  </section>

  <section class="band white">
    <div class="wrap">
      <div class="band-head center">
        <span class="eyebrow">IDEA Economy</span>
        <h2 class="display-sm">Hai không gian dịch vụ của liên minh</h2>
      </div>
      <PillarCards />
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head center">
        <span class="eyebrow">Chuyên gia nói về liên minh</span>
        <h2 class="display-sm">Được tin tưởng bởi những người đồng hành</h2>
      </div>
      <div class="grid-3">
        {quotes.map((q: any) => (
          <div class="quote">
            <blockquote>“{q.q}”</blockquote>
            <div class="who"><b>{q.n}</b>{q.t}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="band white">
    <div class="wrap">
      <div class="band-head center">
        <span class="eyebrow">Đối tác &amp; khách hàng tiêu biểu</span>
        <h2 class="display-sm">Đồng hành cùng các thương hiệu lớn</h2>
      </div>
      <img class="r16" src="/assets/partners.webp" alt="VinGroup, FLC Group, BIDV, Lazada, IMC, Garco 10, Viettel, be, Thiên Khôi, Thăng Tiến, Hanvico, UBCG Hà Nội, SB Fund, Austdoor, DAMAC, BanzaiHobby, OpenReachTech" loading="lazy" style="max-width:1000px;margin:0 auto" />
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="band-head" style="display:flex;justify-content:space-between;align-items:baseline;gap:20px;flex-wrap:wrap">
        <h2 class="display-sm">Tin tức mới</h2>
        <a class="arrow" href="/tin-tuc">Tất cả bài viết</a>
      </div>
      <NewsRows limit={4} />
    </div>
  </section>

  <CtaBand h="Sẵn sàng cùng IDEA phát triển bền vững?" p="Kết nối – Thích nghi – Phát triển. Để lại thông tin để nhận tư vấn từ các ban chuyên môn của liên minh." img="/assets/sl-dongy-chip.webp" />
</Base>
