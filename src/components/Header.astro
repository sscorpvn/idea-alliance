---
interface Props { active?: string }
const { active = '' } = Astro.props;
const cls = (k: string) => (k === active ? 'active' : undefined);
---
<header class="site">
  <div class="wrap">
    <nav class="navbar">
      <a class="brand" href="/">
        <img src="/assets/logo-icon.png" alt="IDEA" />
        <span class="brand-text"><b>IDEA</b><small>Liên minh Kinh tế số &amp; Đổi mới sáng tạo</small></span>
      </a>
      <button class="nav-toggle" aria-label="Mở menu" id="navToggle">
        <span></span><span></span><span></span>
      </button>
      <ul class="nav-links" id="nav">
        <li><a href="/" class={cls('home')}>Trang chủ</a></li>
        <li><a href="/ve-chung-toi" class={cls('about')}>Về chúng tôi</a></li>
        <li class="dropdown">
          <a href="/economy" class={cls('services')}>Dịch vụ</a>
          <ul class="menu">
            <li><a href="/idea-growth">IDEA Co-Growth Space — Marketing &amp; Sales</a></li>
            <li><a href="/idea-tech">IDEA Co-Technology Space — Chuyển đổi số</a></li>
            <li><a href="/quy-trinh">Quy trình triển khai</a></li>
          </ul>
        </li>
        <li class="dropdown">
          <a href="/economy" class={cls('solutions')}>Giải pháp</a>
          <ul class="menu">
            <li><a href="/economy">Tổng quan sản phẩm &amp; giải pháp</a></li>
            <li><a href="/giai-phap/an-ninh-mang">An ninh mạng — Cyber Security</a></li>
            <li><a href="/giai-phap/smartedu360">SmartEdu360 — Phòng học thông minh</a></li>
            <li><a href="/giai-phap/ai-tu-dong-hoa">AI &amp; Tự động hoá</a></li>
            <li><a href="/giai-phap/ban-do-so">Bản đồ số KCN &amp; Xúc tiến đầu tư</a></li>
            <li><a href="/giai-phap/tai-san-so">Tài sản số &amp; Đấu giá</a></li>
            <li><a href="/giai-phap/dien-nang-luong">Điện – Tự động hoá – Năng lượng</a></li>
            <li><a href="/giai-phap/dong-y">Đông Y &amp; Dược liệu số</a></li>
          </ul>
        </li>
        <li><a href="/co-van" class={cls('covan')}>Đội ngũ</a></li>
        <li><a href="/thanh-vien" class={cls('member')}>Thành viên</a></li>
        <li><a href="/tin-tuc" class={cls('news')}>Tin tức</a></li>
      </ul>
      <a class="btn nav-cta" href="/lien-he">Liên hệ</a>
    </nav>
  </div>
</header>
<script>
  document.getElementById('navToggle')?.addEventListener('click', () =>
    document.getElementById('nav')?.classList.toggle('open'));
</script>
