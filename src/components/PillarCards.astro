---
interface Props { short?: boolean }
const { short = false } = Astro.props;
const pillars = [
  { href: '/idea-growth', img: '/assets/growth.webp', name: 'IDEA Co-Growth Space',
    long: 'Phòng Marketing & Sales đồng hành: tư vấn kế hoạch, thiết kế, nội dung, branding và marketing sau bán hàng.',
    shortTxt: 'PR, Marketing & Sales — gia tăng doanh thu.' },
  { href: '/idea-hrds', img: '/assets/hrd.webp', name: 'IDEA HRDs',
    long: 'Phòng hành chính – nhân sự và tuyển dụng thuê ngoài, tinh gọn bộ máy vận hành cho doanh nghiệp.',
    shortTxt: 'Tối ưu chi phí.' },
  { href: '/idea-tech', img: '/assets/tech.webp', name: 'IDEA Co-Technology Space',
    long: 'Dịch vụ công nghệ & chuyển đổi số: tư vấn, đào tạo, triển khai, thuê nhân sự lập trình, outsourcing và white label.',
    shortTxt: 'Công nghệ & chuyển đổi số.' },
];
---
<div class="grid-3">
  {pillars.map(p => (
    <article class="pillar">
      <img src={p.img} alt={p.name} loading="lazy" />
      <div class="pad">
        <h3 class="title-sans">{p.name}</h3>
        <p>{short ? p.shortTxt : p.long}</p>
        <a class="arrow" href={p.href}>Khám phá</a>
      </div>
    </article>
  ))}
</div>
