---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description?: string; active?: string }
const { title, description = 'IDEA — Liên minh Kinh tế số & Đổi mới sáng tạo', active = '' } = Astro.props;
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;1,400&family=Be+Vietnam+Pro:wght@400;500;600;800&display=swap" rel="stylesheet" />
</head>
<body>
  <Header active={active} />
  <main><slot /></main>
  <Footer />
  <script>
    // nav: đổ bóng khi cuộn
    const hd = document.querySelector('header.site');
    addEventListener('scroll', () => hd?.classList.toggle('scrolled', scrollY > 24), { passive: true });
    // scroll reveal: tự gắn cho các khối nội dung (trừ hero — có load-in riêng)
    const sel = '.band .card,.band .pillar,.band .quote,.band .person,.band .price,.band .row-item,.band .band-head,.band .cols>div,.band .strip img,.page-head .cols>div,.page-head>.wrap>*';
    const els = [...document.querySelectorAll(sel)].filter(el => !el.closest('.hero'));
    els.forEach(el => el.classList.add('rv'));
    // stagger trong lưới
    document.querySelectorAll('.grid-2,.grid-3,.grid-4,.strip,.rows').forEach(g =>
      [...g.children].forEach((c, i) => (c as HTMLElement).style.setProperty('--d', `${(i % 6) * 80}ms`)));
    const io = new IntersectionObserver(entries => entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }), { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    els.forEach(el => io.observe(el));
  </script>
</body>
</html>
